COMPOSE_PROJECT_NAME=nhu-tung-demo
POSTGRES_DB=nhutung
POSTGRES_USER=nhutung
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+psycopg://nhutung:replace-with-a-local-password@db:5432/nhutung
API_PORT=8001
WEB_PORT=5174
VITE_API_BASE_URL=/api
APP_ENV=local
LOG_LEVEL=INFO
SESSION_TTL_SECONDS=28800
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCKOUT_ENABLED=true
LOGIN_FAILURE_WINDOW_SECONDS=900
SCALE_INGESTION_MAX_FUTURE_SECONDS=300
SCALE_INGESTION_MAX_BODY_BYTES=65536
PILOT_EVIDENCE_MAX_FILE_BYTES=10485760
PILOT_EVIDENCE_QUOTA_PER_FACILITY_BYTES=5368709120
PILOT_EVIDENCE_RETENTION_DAYS=30
PILOT_AI_MODE=disabled
PILOT_AI_QUEUE_LIMIT=20
